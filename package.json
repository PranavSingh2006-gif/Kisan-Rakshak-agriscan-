{
  "name": "kisan-rakshak",
  "name": "hackdevenger-agriscan-workspace",
  "version": "2.0.0",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Kisan Rakshak / AgriScan Monorepo with separated Frontend and Backend",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@google/generative-ai": "^0.24.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
    "dev:frontend": "npm --prefix agriscan-frontend run dev",
    "dev:backend": "npm --prefix agriscan-backend run start",
    "build:frontend": "npm --prefix agriscan-frontend run build",
    "install:all": "npm --prefix agriscan-backend install && npm --prefix agriscan-frontend install"
  }
}
